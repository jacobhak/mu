[Unit]
Description=ai-provider-gateway maintenance bot (%i)
[Service]
Type=oneshot
Environment=PATH=%h/.mu/bin:%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GIT_CONFIG_GLOBAL=%h/.local/state/ai-provider-gateway-maint/gitconfig GIT_TERMINAL_PROMPT=0 GH_PROMPT_DISABLED=1
EnvironmentFile=-%h/.local/state/ai-provider-gateway-maint/config.env
WorkingDirectory=%h/.local/state/ai-provider-gateway-maint/repo
ExecStart=/bin/bash -c 'git fetch -q origin && git reset -q --hard origin/main && exec scripts/maint/run.sh %i'
TimeoutStartSec=3h
Nice=10
