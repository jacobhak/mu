[Unit]
Description=mu maintenance bot (%i)
[Service]
Type=oneshot
Environment=PATH=%h/.mu/bin:%h/.cargo/bin:%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GIT_CONFIG_GLOBAL=%h/.mu/maint/gitconfig GIT_TERMINAL_PROMPT=0 GH_PROMPT_DISABLED=1 CARGO_NET_GIT_FETCH_WITH_CLI=true
EnvironmentFile=-%h/.mu/maint/config.env
WorkingDirectory=%h/.mu/maint/mu
ExecStart=/bin/bash -c 'git fetch -q origin && git reset -q --hard origin/main && exec scripts/maint/run.sh %i'
TimeoutStartSec=3h
# The default (stop) turned one OOM-killed rustc into SIGTERM for the whole run (issue #46): let the
# stage fail instead, so the run reports it and still publishes main.
OOMPolicy=continue
Nice=10
